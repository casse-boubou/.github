{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":separateMultipleMajorReleases",
    "workarounds:bitnamiDockerImageVersioning",
    "workarounds:clamavDockerImageVersioning",
    "workarounds:nodeDockerVersioning",
    "workarounds:typesNodeVersioning",
    "workarounds:ubuntuDockerVersioning"
  ],
  "labels": ["dependencies"],
  "timezone": "Europe/Paris",
  "schedule": ["* * * * *"],
  "prHourlyLimit": 0,
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "prCreation": "not-pending",
  "rebaseWhen": "behind-base-branch",
  "dependencyDashboardLabels": ["dependencies"],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "commitMessagePrefix": "⬆️ MAJOR",
      "commitMessageTopic": "github-actions {{packageName}}",
      "groupName": "github-actions",
      "rebaseWhen": "conflicted"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "commitMessagePrefix": "⬆️",
      "commitMessageTopic": "github-actions {{packageName}}",
      "groupName": "github-actions minor and_or patch",
      "rebaseWhen": "conflicted",
      "automerge": true
    },
    {
      "matchManagers": ["dockerfile"],
      "matchDatasources": ["docker"],
      "commitMessagePrefix": "⬆️",
      "commitMessageTopic": "docker {{packageName}} image"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["repology"],
      "commitMessagePrefix": "⬆️",
      "commitMessageTopic": "{{depName}}",
      "groupName": "internal packages"
    }
  ]
}
